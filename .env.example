# Copy to .env and fill in. .env is gitignored and never travels with the project.
#   cp .env.example .env && open -t .env

# ---- REQUIRED: nothing works without these -------------------------------
# kie.ai — the avatar video engine (kling/ai-avatar-standard). This is the
# only line item that costs real money per reel (~$0.0383/s, ~$2-6 a reel).
# https://kie.ai  → top up before a batch; a reel fails mid-render at $0.
KIE_API_KEY=

# ElevenLabs — the monk's voice, and the audiobook. Free tier is too small
# for a batch; the audiobook alone is ~60k characters.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Blotato — posts to Instagram/Facebook/YouTube and runs the DM automations.
# This is the ONLY way this project touches Instagram. Never log in directly.
# https://blotato.com → Settings → API
BLOTATO_API_KEY=

# Apify — reads public competitor accounts and our own numbers. Read-only,
# no cookies, no login. Has a monthly cap: a 403 means the cap is spent,
# a 401 means the token is dead. Both make the morning health board blind.
# https://console.apify.com/settings/integrations
APIFY_TOKEN=

# ---- OPTIONAL ------------------------------------------------------------
# Second Apify token, used to keep scraping after the first cap is spent.
APIFY_TOKEN_2=

# Voice ids. Both have working defaults in code, so leave blank unless you
# want a different voice. EL_VOICE -> scripts/eleven.py, KAION_VOICE ->
# scripts/build_reels.py, EL_VOICE_PT -> the Portuguese lane.
EL_VOICE=
KAION_VOICE=
EL_VOICE_PT=
EL_VOICE_ES=

# fal.ai — an alternative avatar engine (scripts/fal_avatar.py). Only needed
# if you deliberately switch engines away from kie.
FAL_KEY=

# TikTok handle, for the manual posting rotation. TikTok is hand-posted
# forever in this project — never automated.
TIKTOK_HANDLE=

# Google account for Drive for desktop (only the Portuguese lane uses it)
DRIVE_ACCOUNT=
